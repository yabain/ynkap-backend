{
  "name": "y-nkapp",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:mtn-keys": "ts-node -r tsconfig-paths/register src/scripts/generate-mtn-keys.ts",
    "test:payment-methods": "ts-node -r tsconfig-paths/register src/scripts/test-payment-methods.ts",
    "history:payments": "ts-node -r tsconfig-paths/register src/scripts/get-payment-history.ts",
    "fetch:transactions": "ts-node -r tsconfig-paths/register src/scripts/fetch-transaction-history.ts",
    "diagnose:transactions": "ts-node -r tsconfig-paths/register src/scripts/diagnose-transactions.ts",
    "test:logs": "ts-node -r tsconfig-paths/register src/scripts/test-logs.ts",
    "test:transaction-logs": "ts-node -r tsconfig-paths/register src/scripts/test-transaction-logs.ts",
    "test:mtn-routes": "npx ts-node -r tsconfig-paths/register src/scripts/test-mtn-routes.ts",
    "test:mtn-routes-prod": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-mtn-routes.ts",
    "extract:app-keys": "ts-node -r tsconfig-paths/register src/scripts/extract-app-keys.ts",
    "convert:logs-to-capped": "ts-node -r tsconfig-paths/register src/scripts/convert-logs-to-capped.ts",
    "check:transactions": "ts-node -r tsconfig-paths/register src/scripts/check-transactions.ts",
    "generate:mtn-prod-keys": "ts-node -r tsconfig-paths/register src/scripts/generate-mtn-prod-keys.ts",
    "test:mtn-prod": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-mtn-prod.ts",
    "test:mtn-connectivity": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-mtn-connectivity.ts",
    "test:wallet-payment": "ts-node -r tsconfig-paths/register src/scripts/test-wallet-payment.ts",
    "seed:transactions-simple": "ts-node -r tsconfig-paths/register src/scripts/seed-transactions-simple.ts",
    "scripts:manager": "ts-node -r tsconfig-paths/register src/scripts/script-manager.ts",
    "test:mtn-direct": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-mtn-direct.ts",
    "test:payment-prod": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-production-payment.ts",
    "test:mtn-prod-safe": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-mtn-prod-safe.ts",
    "check:prod-config": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/check-mtn-prod-status.ts",
    "test:mtn-prod-fixed": "cross-env NODE_ENV=prod ts-node -r tsconfig-paths/register src/scripts/test-production-payment.ts",
    "generate:app-test-keys": "ts-node -r tsconfig-paths/register src/scripts/generate-app-test-keys.ts"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^25.0.4",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.3",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/websockets": "^10.4.3",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.3.0",
    "inquirer": "^8.2.5",
    "keycloak-api-ts": "^1.0.0",
    "keycloak-connect": "^24.0.5",
    "keycloak-js": "^25.0.4",
    "mongoose": "^8.5.1",
    "nest-keycloak-connect": "^1.10.1",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.1",
    "passport-keycloak": "^0.0.7",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-http": "^0.3.11",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.14.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "mkcert": "^3.2.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
