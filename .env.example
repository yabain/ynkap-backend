# Database
MONGODB_URI=mongodb://localhost:27017/ynkap

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Google Cloud Storage Configuration
GCS_PROJECT_ID=your-gcs-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_KEY_FILENAME=./path/to/your/service-account-key.json
GCS_PUBLIC_URL=https://storage.googleapis.com

# File Upload Configuration
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=10
TEMP_DIR=./uploads/temp

# File Validation
CHECK_FILE_SIGNATURE=true
SCAN_FOR_VIRUSES=false

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=debug

# Redis (if using for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (if using for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Keycloak (if using for authentication)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# reCAPTCHA (for bot protection)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
